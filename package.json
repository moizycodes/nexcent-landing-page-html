{
  "name": "nexcent-landing-page-html",
  "version": "1.0.0",
  "private": true,
  "description": "A clean, modern, and fully responsive Nexcent landing page built with HTML5, Tailwind CSS v4, Tailwind CLI, and Vanilla JavaScript, based on a Figma design.",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/css/output.css --watch",
    "build": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/css/output.css --minify",
    "preview": "live-server ."
  },
  "keywords": [
    "nexcent",
    "landing-page",
    "html",
    "tailwindcss",
    "tailwindcss-v4",
    "vanilla-javascript",
    "responsive-design",
    "figma"
  ],
  "author": "moizycodes",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "live-server": "^1.2.2",
    "tailwindcss": "^4.3.3"
  }
}